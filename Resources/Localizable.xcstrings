    "Downloads are in progress. Quitting stops them; they’ll be paused and can be resumed next time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads laufen noch. Beim Beenden werden sie angehalten, pausiert und können beim nächsten Mal fortgesetzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay descargas en curso. Al salir se detendrán; quedarán en pausa y podrás reanudarlas la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des téléchargements sont en cours. Quitter les arrête ; ils seront mis en pause et pourront être repris la prochaine fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sono download in corso. Uscendo verranno interrotti; saranno messi in pausa e potrai riprenderli la prossima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードが進行中です。終了すると停止しますが、一時停止状態になり、次回再開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드가 진행 중입니다. 종료하면 중단되지만 일시 정지 상태가 되며 다음에 재개할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er lopen nog downloads. Als je stopt, worden ze onderbroken; ze worden gepauzeerd en kunnen de volgende keer worden hervat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há downloads em andamento. Ao sair, eles serão interrompidos; ficarão pausados e poderão ser retomados na próxima vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载正在进行中。退出会使其停止；它们将被暂停，下次可以继续。"
          }
        }
      }
    },
