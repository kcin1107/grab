    "Albums go into Artist/Album, playlists into a folder with their name, when you download two or more items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alben landen in Künstler/Album, Playlists in einem Ordner mit ihrem Namen, wenn du zwei oder mehr Objekte lädst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los álbumes van a Artista/Álbum y las listas a una carpeta con su nombre, cuando descargas dos o más elementos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les albums vont dans Artiste/Album, les playlists dans un dossier à leur nom, quand vous téléchargez deux éléments ou plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli album vanno in Artista/Album e le playlist in una cartella con il loro nome, quando scarichi due o più elementi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 つ以上の項目をダウンロードすると、アルバムは「アーティスト/アルバム」に、プレイリストはその名前のフォルダに入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 개 이상의 항목을 다운로드하면 앨범은 아티스트/앨범으로, 재생목록은 그 이름의 폴더로 들어갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albums gaan naar Artiest/Album en afspeellijsten naar een map met hun naam als je twee of meer onderdelen downloadt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Álbuns vão para Artista/Álbum e playlists para uma pasta com o nome delas, quando você baixa dois ou mais itens."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载两个或更多项目时，专辑存入“艺人/专辑”，播放列表存入以其名称命名的文件夹。"
          }
        }
