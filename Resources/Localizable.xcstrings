    "ffmpeg isn’t installed, so merging video and converting audio will fail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ffmpeg ist nicht installiert, daher schlagen das Zusammenführen von Video und die Audiokonvertierung fehl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ffmpeg no está instalado, así que unir vídeo y convertir audio fallará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ffmpeg n’est pas installé : la fusion vidéo et la conversion audio vont échouer."
          }
        },
        "it" : {
          "stringUnit" : {
