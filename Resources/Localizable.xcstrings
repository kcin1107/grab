    "Saves only the part you choose below, in the same quality." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert nur den unten gewählten Abschnitt in derselben Qualität."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda solo la parte que elijas abajo, con la misma calidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre uniquement la partie choisie ci-dessous, avec la même qualité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva solo la parte scelta qui sotto, con la stessa qualità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下で選択した範囲だけを同じ品質で保存します。"
