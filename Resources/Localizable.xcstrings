    "Automatic keeps the resolution unless the file gets so small that a lower one looks sharper" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch behält die Auflösung, außer die Datei wird so klein, dass eine niedrigere schärfer aussieht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático mantiene la resolución, salvo que el archivo quede tan pequeño que una menor se vea más nítida"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique conserve la résolution, sauf si le fichier devient si petit qu’une résolution inférieure paraît plus nette"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatico mantiene la risoluzione, a meno che il file diventi così piccolo che una inferiore appaia più nitida"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」は解像度を保ちますが、ファイルがかなり小さくなる場合は、より鮮明に見える低い解像度にします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동은 해상도를 유지하지만, 파일이 아주 작아져 더 낮은 해상도가 더 선명해 보이면 낮춥니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
