    "Grab couldn’t read this file. It may not be audio or video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab konnte diese Datei nicht lesen. Vielleicht ist es kein Audio oder Video."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab no pudo leer este archivo. Puede que no sea audio ni vídeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab n’a pas pu lire ce fichier. Ce n’est peut-être ni de l’audio ni de la vidéo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab non è riuscito a leggere questo file. Potrebbe non essere audio o video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab はこのファイルを読み込めませんでした。オーディオやビデオではない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab이 이 파일을 읽을 수 없습니다. 오디오나 비디오가 아닐 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab kon dit bestand niet lezen. Misschien is het geen audio of video."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Grab não conseguiu ler este arquivo. Talvez não seja áudio nem vídeo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab 无法读取此文件。它可能不是音频或视频。"
          }
        }
      }
    },
    "Grab couldn’t tell how long this file is, so it can’t aim for a size." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab konnte die Länge dieser Datei nicht ermitteln und kann daher keine Größe anpeilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab no pudo saber cuánto dura este archivo, así que no puede apuntar a un tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab n’a pas pu déterminer la durée de ce fichier et ne peut donc pas viser une taille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab non è riuscito a capire quanto dura questo file, quindi non può puntare a una dimensione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルの長さがわからないため、サイズを目標にできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일의 길이를 알 수 없어 크기를 맞출 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab kon niet bepalen hoe lang dit bestand is, dus kan het niet op een grootte mikken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Grab não conseguiu saber a duração deste arquivo, então não pode mirar um tamanho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab 无法判断此文件的时长，因此无法按目标大小压缩。"
          }
        }
      }
    },
    "Grab keeps its own verified copies of yt-dlp, ffmpeg and the Deno runtime YouTube needs, and checks for updates daily." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab verwaltet eigene geprüfte Kopien von yt-dlp, ffmpeg und der Deno-Laufzeit, die YouTube benötigt, und sucht täglich nach Updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab mantiene sus propias copias verificadas de yt-dlp, ffmpeg y del entorno de ejecución de Deno que necesita YouTube, y busca actualizaciones cada día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab conserve ses propres copies vérifiées de yt-dlp, de ffmpeg et de l’environnement d’exécution Deno dont YouTube a besoin, et recherche des mises à jour chaque jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab conserva copie verificate di yt-dlp, ffmpeg e del runtime Deno richiesto da YouTube, e controlla gli aggiornamenti ogni giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab は、yt-dlp、ffmpeg、YouTube に必要な Deno ランタイムの検証済みコピーを独自に保持し、毎日アップデートを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab은 yt-dlp, ffmpeg 및 YouTube에 필요한 Deno 런타임의 검증된 사본을 자체적으로 보관하며 매일 업데이트를 확인합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab bewaart eigen geverifieerde kopieën van yt-dlp, ffmpeg en de Deno-runtime die YouTube nodig heeft, en zoekt dagelijks naar updates."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Grab mantém cópias verificadas próprias do yt-dlp, do ffmpeg e do runtime Deno de que o YouTube precisa, e procura atualizações todos os dias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab 自带经过验证的 yt-dlp、ffmpeg 以及 YouTube 所需的 Deno 运行时副本，并每天检查更新。"
          }
        }
      }
    },
